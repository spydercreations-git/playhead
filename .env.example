# Frontend & API URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Database & Cache
DATABASE_URL=postgres://postgres:postgres@localhost:5432/playhead_dev?sslmode=disable
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO in local dev)
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=playhead
R2_SECRET_ACCESS_KEY=playheadsecret
R2_BUCKET=playhead-dev
R2_ENDPOINT=http://localhost:9000

# Auth & Sessions
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend in prod, Mailpit in local dev)
RESEND_API_KEY=
EMAIL_FROM=notifications@playhead.app
SMTP_HOST=localhost
SMTP_PORT=1025

# Billing (Paddle)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

# Observability
SENTRY_DSN=
PORT=8080
